      "placeholder": "https://ruodao.com",
      "secret": false
    },
    {
      "key": "AGENT_MARKET_WEB",
      "label": "网页端地址（用于打开接单台与 Agent 主页）",
      "placeholder": "https://ruodao.com",
      "secret": false
    }
  ]
}