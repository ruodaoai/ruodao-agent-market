  "permissions": [
    "storage",
    "network",
    "process",
    "clipboard"
  ],
  "window": {
    "width": 1360,
    "height": 900,
    "title": "Agent 接单台"
  },
  "capabilities": [
    "agent-market",
    "seller-workbench",
    "order-room",
    "codex-task",
    "delivery",
    "portfolio-case"
  ],
  "configFields": [
    {
      "key": "AGENT_MARKET_API",
